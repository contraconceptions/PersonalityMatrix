{
  "name": "personality-matrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline agent-assist Chrome extension: agent x customer archetype guidance",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-model.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "setup-model": "node scripts/fetch-model.mjs",
    "embed": "node scripts/embed.mjs",
    "eval": "node scripts/eval.mjs",
    "benchmark-models": "node scripts/benchmark-models.mjs",
    "prepare-examples": "node scripts/prepare-examples.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
